# The app's own public URL, with no trailing slash.
#
# Supabase redirects the browser back here after sign-in, and Paystack redirects
# the customer back here after paying. Both must know the real deployed address,
# or they will send visitors to http://localhost:3000 instead of your site.
#
# In production this is your Vercel domain, e.g. https://hefa-store.vercel.app.
# It also has to be allow-listed in Supabase → Authentication → URL Configuration
# (as a Redirect URL) or sign-in will bounce back to an error page.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Dashboard → Project Settings → Data API
#
# Copy this file to `.env.local` and paste in your own values.
# `.env.local` is git-ignored, so your real keys stay on your machine.

# Project URL — Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — Project Settings → Data API → API Keys
# This key is safe to use in the browser: Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Service-role (secret) key — same screen, the second key
# Required to create orders, which deliberately cannot be written from the
# browser. Leave the name WITHOUT a NEXT_PUBLIC_ prefix: that prefix would
# inline the key into the JavaScript bundle and hand it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key-here

# Paystack — Dashboard → Settings → API Keys & Webhooks, with Test mode ON
# sk_test is a SECRET: server only, never committed. Rotate it before going live
# if it has ever been pasted into a chat, a screenshot or an issue.
PAYSTACK_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here

# Email (order confirmations) - Resend -> API Keys
#
# Optional. With no key the store still records every order and simply
# logs that the confirmation email was skipped, so checkout works without
# it. Add a free key to start sending.
RESEND_API_KEY=re_your-key-here

# The address customers see, e.g. HEFA <orders@hefastore.com>
#
# Leave this unset and it falls back to Resend's shared testing sender.
# That fallback only delivers to the address that owns your Resend account,
# so it is useful for trying the template and useless for real customers:
# Resend rejects every other recipient with a 403. To email customers, set
# this to an address on a domain you have verified at resend.com/domains.
# The storefront checks for that and will not promise a confirmation email
# it cannot deliver.
EMAIL_FROM=HEFA <orders@your-verified-domain.com>

# WARNING: every value in this file is a placeholder. Never commit a real
# secret key. `.env.local` is the only file that should hold one, and it is
# git-ignored.
