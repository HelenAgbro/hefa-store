# Supabase — Dashboard → Project Settings → Data API
#
# Copy this file to `.env.local` and paste in your own values.
# `.env.local` is git-ignored, so your real keys stay on your machine.

# Project URL — Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — Project Settings → Data API → API Keys
# This key is safe to use in the browser: Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Service-role (secret) key — same screen, the second key
# Required to create orders, which deliberately cannot be written from the
# browser. Leave the name WITHOUT a NEXT_PUBLIC_ prefix: that prefix would
# inline the key into the JavaScript bundle and hand it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key-here

# WARNING: every value in this file is a placeholder. Never commit a real
# secret key. `.env.local` is the only file that should hold one, and it is
# git-ignored.
